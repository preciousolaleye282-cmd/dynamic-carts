# ============================================================================
# Dynamic Carts - environment
#
#   cp .env.example .env.local
#
# The app runs with NONE of these set. It serves the bundled catalogue from
# data/catalogue.json, hides the Google button, and prints the confirmation
# email to the server log instead of sending it. Add one group at a time.
# ============================================================================

# Where the site is served from. Must match the Google redirect URI exactly.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ---------------------------------------------------------------------------
# Database - EITHER Supabase OR Neon, nothing in between
# ---------------------------------------------------------------------------
# One variable covers both. Both speak the PostgreSQL wire protocol, so the
# driver is identical; only the hostname changes.
#
#   Supabase  Dashboard -> Project Settings -> Database -> Connection string
#             postgres://postgres.PROJECT:PASSWORD@aws-0-US-EAST-1.pooler.supabase.com:5432/postgres
#
#   Neon      Console -> Connection Details -> "pooled" connection string
#             postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Use the *pooled* host on serverless. Supabase: the `.pooler.` hostname.
# Neon: the `-pooler` hostname.
#
# DATABASE_URL=

# Both providers are TLS-only, so this defaults to true. Set false only for a
# local Postgres you are running yourself.
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# First run: apply db/schema.sql then db/seed.sql, or `npm run db:setup`.


# ---------------------------------------------------------------------------
# Google sign-in
# ---------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create credentials
# -> OAuth client ID -> Application type: "Web application".
#
# Add BOTH of these as Authorised redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://your-domain.com/api/auth/callback/google
#
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback/google

# Signs the session cookie and the OAuth state. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=


# ---------------------------------------------------------------------------
# Mailgun - order confirmations
# ---------------------------------------------------------------------------
# Mailgun -> Sending -> Domains -> add your domain, then copy the API keys
# from the "Sending" page. MAILGUN_FROM must be an address on that domain.
#
# MAILGUN_API_KEY=key-xxxxxxxxxxxxxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com
# MAILGUN_FROM="Dynamic Carts <orders@mg.yourdomain.com>"
# For the EU region: MAILGUN_API_HOST=api.eu.mailgun.net
